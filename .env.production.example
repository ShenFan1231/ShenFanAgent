# Copy this file to .env.production.local on the deployment host.
# Never commit the real file.

APP_VERSION=latest
PUBLIC_ORIGIN=https://shenfan1231.top

POSTGRES_DB=nebula
POSTGRES_USER=nebula
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_HASH_ROUNDS=12

# Production refresh cookies are sent only over HTTPS.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-locally-never-commit
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=60000
