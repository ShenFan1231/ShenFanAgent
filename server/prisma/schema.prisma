generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum MenuType {
  DIRECTORY
  MENU
  BUTTON
  LINK
}

enum OrderStatus {
  PAID
  PENDING
  REFUNDED
  CLOSED
}

enum ProjectType {
  GAME
  APPLICATION
  AI_AGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OperationLevel {
  INFO
  SUCCESS
  WARNING
  DANGER
}

enum NotificationType {
  SYSTEM
  TODO
  MESSAGE
}

enum AgentConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AgentMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentToolStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  username           String              @unique @db.VarChar(64)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  nickname           String              @db.VarChar(80)
  avatar             String?             @db.VarChar(500)
  email              String              @unique @db.VarChar(160)
  phone              String?             @db.VarChar(32)
  department         String?             @db.VarChar(100)
  jobTitle           String?             @map("job_title") @db.VarChar(100)
  status             UserStatus          @default(ACTIVE)
  lastLoginAt        DateTime?           @map("last_login_at")
  lastLoginIp        String?             @map("last_login_ip") @db.VarChar(64)
  loginStreak        Int                 @default(0) @map("login_streak")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  roles              UserRole[]
  refreshTokens      RefreshSession[]
  operationLogs      OperationLog[]
  ownedProjects      Project[]           @relation("ProjectOwner")
  settingsUpdated    SystemSetting[]     @relation("SettingUpdater")
  notificationReads  NotificationRead[]
  agentConversations AgentConversation[]
  agentMessages      AgentMessage[]
  agentRuns          AgentRun[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(80)
  description String?          @db.VarChar(255)
  enabled     Boolean          @default(true)
  isSystem    Boolean          @default(false) @map("is_system")
  sort        Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]
  menus       RoleMenu[]

  @@index([enabled, sort])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(100)
  module      String           @db.VarChar(64)
  action      String           @db.VarChar(64)
  description String?          @db.VarChar(255)
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]
  menus       Menu[]

  @@index([module, enabled])
  @@map("permissions")
}

model Menu {
  id           String      @id @default(uuid()) @db.Uuid
  parentId     String?     @map("parent_id") @db.Uuid
  permissionId String?     @map("permission_id") @db.Uuid
  type         MenuType    @default(MENU)
  name         String      @db.VarChar(100)
  routeName    String?     @unique @map("route_name") @db.VarChar(100)
  path         String      @db.VarChar(255)
  componentKey String?     @map("component_key") @db.VarChar(160)
  icon         String?     @db.VarChar(100)
  badge        String?     @db.VarChar(32)
  externalLink String?     @map("external_link") @db.VarChar(500)
  hidden       Boolean     @default(false)
  keepAlive    Boolean     @default(false) @map("keep_alive")
  enabled      Boolean     @default(true)
  sort         Int         @default(0)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  parent       Menu?       @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Menu[]      @relation("MenuTree")
  permission   Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)
  roles        RoleMenu[]

  @@index([parentId, sort])
  @@index([enabled, hidden])
  @@map("menus")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RoleMenu {
  roleId     String   @map("role_id") @db.Uuid
  menuId     String   @map("menu_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@index([menuId])
  @@map("role_menus")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  persistent Boolean   @default(false)
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  orderNo   String      @unique @map("order_no") @db.VarChar(64)
  customer  String      @db.VarChar(100)
  channel   String      @db.VarChar(64)
  amount    Decimal     @db.Decimal(14, 2)
  status    OrderStatus @default(PENDING)
  items     Int         @default(1)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([customer])
  @@map("orders")
}

model DailyMetric {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @unique @db.Date
  visits      Int
  uniqueUsers Int      @map("unique_users")
  revenue     Decimal  @db.Decimal(14, 2)
  newUsers    Int      @map("new_users")
  activeUsers Int      @map("active_users")
  orders      Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("daily_metrics")
}

model TrafficSourceMetric {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  value     Int
  sort      Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sort])
  @@map("traffic_source_metrics")
}

model RegionMetric {
  id        String   @id @default(uuid()) @db.Uuid
  region    String   @unique @db.VarChar(80)
  value     Int
  sort      Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sort])
  @@map("region_metrics")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  group       String   @db.VarChar(64)
  label       String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  value       Json
  sensitive   Boolean  @default(false)
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group])
  @@map("system_settings")
}

model OperationLog {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @map("user_id") @db.Uuid
  level      OperationLevel @default(INFO)
  module     String         @db.VarChar(64)
  action     String         @db.VarChar(100)
  resource   String?        @db.VarChar(100)
  resourceId String?        @map("resource_id") @db.VarChar(100)
  summary    String         @db.VarChar(255)
  method     String?        @db.VarChar(16)
  path       String?        @db.VarChar(500)
  ipAddress  String?        @map("ip_address") @db.VarChar(64)
  userAgent  String?        @map("user_agent") @db.VarChar(500)
  statusCode Int?           @map("status_code")
  durationMs Int?           @map("duration_ms")
  success    Boolean        @default(true)
  detail     Json?
  createdAt  DateTime       @default(now()) @map("created_at")
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([module, action])
  @@map("operation_logs")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(64)
  name        String        @db.VarChar(120)
  description String?       @db.VarChar(500)
  type        ProjectType
  status      ProjectStatus @default(PLANNING)
  ownerId     String?       @map("owner_id") @db.Uuid
  members     Int           @default(1)
  progress    Int           @default(0)
  budget      Decimal       @default(0) @db.Decimal(14, 2)
  tags        String[]
  startedAt   DateTime?     @map("started_at") @db.Date
  dueAt       DateTime?     @map("due_at") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  owner       User?         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([type])
  @@map("projects")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  title     String             @db.VarChar(160)
  content   String             @db.VarChar(1000)
  type      NotificationType
  createdAt DateTime           @default(now()) @map("created_at")
  reads     NotificationRead[]

  @@index([createdAt])
  @@map("notifications")
}

model NotificationRead {
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_reads")
}

model AgentConversation {
  id            String                  @id @default(uuid()) @db.Uuid
  userId        String                  @map("user_id") @db.Uuid
  title         String                  @db.VarChar(160)
  summary       String?                 @db.VarChar(500)
  status        AgentConversationStatus @default(ACTIVE)
  lastMessageAt DateTime?               @map("last_message_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AgentMessage[]
  runs          AgentRun[]

  @@index([userId, status, updatedAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  runId          String?           @map("run_id") @db.Uuid
  authorId       String?           @map("author_id") @db.Uuid
  role           AgentMessageRole
  content        String            @db.Text
  sequence       Int
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run            AgentRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  author         User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([conversationId, sequence])
  @@index([runId])
  @@map("agent_messages")
}

model AgentRun {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  requestedById  String            @map("requested_by_id") @db.Uuid
  status         AgentRunStatus    @default(PENDING)
  provider       String            @db.VarChar(64)
  model          String            @db.VarChar(100)
  taskTitle      String            @map("task_title") @db.VarChar(200)
  currentStep    String?           @map("current_step") @db.VarChar(200)
  totalSteps     Int               @default(1) @map("total_steps")
  completedSteps Int               @default(0) @map("completed_steps")
  progress       Int               @default(0)
  error          String?           @db.Text
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy    User              @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  messages       AgentMessage[]
  toolCalls      AgentToolCall[]

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@map("agent_runs")
}

model AgentToolCall {
  id          String          @id @default(uuid()) @db.Uuid
  runId       String          @map("run_id") @db.Uuid
  callId      String          @unique @map("call_id") @db.VarChar(100)
  name        String          @db.VarChar(120)
  displayName String          @map("display_name") @db.VarChar(160)
  status      AgentToolStatus @default(PENDING)
  input       Json
  output      Json?
  error       String?         @db.Text
  startedAt   DateTime?       @map("started_at")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  run         AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("agent_tool_calls")
}
