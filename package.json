{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "pnpm --filter @nebula/api start:dev",
    "build": "pnpm run build:web && pnpm run build:api",
    "build:web": "vue-tsc -b && vite build",
    "build:api": "pnpm --filter @nebula/api build",
    "preview": "vite preview",
    "db:generate": "pnpm --filter @nebula/api prisma:generate",
    "db:validate": "pnpm --filter @nebula/api prisma:validate",
    "db:migrate": "pnpm --filter @nebula/api prisma:migrate",
    "db:seed": "pnpm --filter @nebula/api prisma:seed"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.120",
    "@types/node": "^24.13.2",
    "@unocss/reset": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "unocss": "^66.7.5",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
}
